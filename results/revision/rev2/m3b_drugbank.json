 "criteria": {
  "drugbank_source": "~/Downloads/drugbank_all_full_database.xml.zip; version and exported-on read from the drugbank root element and written to every output",
  "resolution": "the experiment 5 rule (scripts/amend7_cpu_exp5_dissociation.py resolve, equivalent to ddiood.drugbank.validate): names plus RxNorm normalized and canonicalized forms from artifacts/vocab/drug_lookup.json; listed if either drug's DrugBank interaction list names the other",
  "a_random_pairs": "the SemEval vocabulary is the 992 keys of artifacts/vocab/drug_lookup.json; 10000 unordered pairs of two keys with different RxCUI drawn uniformly with replacement of pairs (numpy RandomState(1)); primary rate = listed / pairs with at least one drug resolved (the exp5 'resolvable' denominator); also listed / all and listed / both resolved; Wilson 95% intervals. Secondary: the same with one key per RxCUI (alphabetically first key). Compared with SemEval test negatives and positives on the same denominators, with and without self pairs",
  "b_by_source": "DrugBank lookup pooled AUROC on SemEval test against binary SemEval labels, by corpus folder (DrugBank = DDI-DrugBank documents, MedLine = DDI-MedLine abstracts), all pairs and without self pairs (case and space normalised same name), unresolvable counted as not listed, sentence-cluster bootstrap 1000 draws seed 42 (ev.boot_auroc)",
  "c_string_match": "non_di_label_string_match pooled AUROC with intervals copied from results/corrected/baselines.json (two-way cluster bootstrap, seed 42); additionally within-drug AUROC on Novel and Older-clean from results/corrected/baseline_scores.json with paired_draws two-way intervals (1000, seeds 1042 / 42)",
  "d_subgroups": "algebraic decomposition: for a 0/1 score AUROC = 0.5 (1 + TPR - FPR); report TPR and FPR per subgroup and the subgroup weights among positives and among negatives that produce the pooled value, for all 2810 pairs and without self pairs"
