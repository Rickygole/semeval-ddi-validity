{
 "status": "post hoc and exploratory; criteria in criteria.json were written before computing; changes no preregistered decision",
 "criteria": {
  "analysis_0_kappa_framing": {
   "primary_statistic": "H1 kappa = (AUROC_b2mixed - 0.5) / (AUROC_DrugBank - 0.5), within-drug, Older-clean tier A, with the 95% interval from the two-way bootstrap with paired draws for b2mixed and DrugBank (seed 42, 1,000 draws); the 95% upper bound is the headline number",
   "secondary": "the same under the one-way drug bootstrap; H1-novel and H6 rows on Novel; tier B rows are reported with the note that DrugBank is 1.0 on tier B by construction, so the tier B kappa reduces to 2 x (AUROC - 0.5)",
   "reading": "the upper bound states the largest share of the DrugBank-lookup within-drug signal that b2mixed can carry at 95% confidence; no decision rule is attached"
  },
  "analysis_1a_one_way": {
   "rows": "H1, H1-novel, H4 and H6, tiers A and B",
   "primary_statistic": "one-way drug bootstrap 90% and 95% percentile intervals and p_TOST, beside the two-way values recomputed by the same code",
   "equivalent_under_one_way": "90% interval inside [0.40, 0.60] (p_TOST < 0.05, unadjusted); Holm across H1, H4 and H6 under the one-way bootstrap is reported beside it",
   "below_chance_under_one_way": "if the one-way 95% interval of a row lies entirely below 0.5 (and separately if the 90% interval does), the row is reported as significantly below chance under the one-way bootstrap (inverted information), not as equivalence",
   "decision_effect": "none; the preregistered two-way decisions stand"
  },
  "analysis_1c_bayes": {
   "rows": "H1, H1-novel, H4 (difference, region [-0.10, 0.10]) and H6, tiers A and B",
   "primary_model": "Bayesian bootstrap over drugs (Rubin 1981): Dirichlet(1, ..., 1) weights on the cohort's drugs, AUROC = sum_d w_d U_d / sum_d w_d N_d with U_d the within-drug wins (ties 0.5) and N_d the comparisons of drug d; 20,000 posterior draws, seed 11; H4 uses independent draws per cohort",
   "prior": "the Bayesian bootstrap is the posterior of a Dirichlet process prior on the distribution of drugs with concentration tending to 0: a noninformative prior that puts all mass on the observed drug types and no parametric prior on the AUROC; partners are fixed",
   "secondary_model": "two-way Bayesian bootstrap: independent Dirichlet(1) weights on drugs and on partners, comparison weight w_d x w_partner(pos) x w_partner(neg); 4,000 draws, seed 12",
   "primary_statistic": "posterior probability that the within-drug AUROC lies in [0.40, 0.60]; 90% and 95% equal-tailed credible intervals and P(AUROC < 0.5) beside it, reported next to the frequentist two-way and one-way results",
   "practically_equivalent": "posterior probability at least 0.95",
   "practically_not_equivalent": "posterior probability at most 0.05",
   "undecided": "otherwise"
  }
 },
